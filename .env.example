# ============================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# .env is gitignored and must never be committed.
# ============================================================

# ---- LLM provider ----
# ollama = local, no quota, seeded/reproducible (default)
# gemini = hosted; free tier is only 20 requests/day on 3.8-flash
LLM_PROVIDER=ollama

# ---- Ollama (local) ----
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=granite4.2:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# ---- Gemini (optional fallback) ----
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model IDs are verified against the live API by `make verify-llm`.
# See scripts/verify_llm.py
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
# Embedding dimension. MUST match the vector(N) column in feedback_memory.
# Changing this requires recreating the table + re-embedding all memories.
EMBEDDING_DIM=

# ---- Postgres (consumed by docker-compose.yml AND the app) ----
POSTGRES_USER=analyst
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=ecommerce
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Read-write connection. Used for schema creation, seeding, feedback memory
# writes and trace logging.
DATABASE_URL=postgresql://analyst:change_me_locally@localhost:5433/ecommerce

# Read-only connection. The agent's generated SQL runs through THIS role only.
# Defence in depth: even if SQL validation is bypassed, the role cannot write.
# Password is set by docker/initdb/01_roles.sql
DATABASE_URL_RO=postgresql://agent_ro:agent_ro_pw@localhost:5433/ecommerce

# ---- pgAdmin (browser DB GUI at http://localhost:5050) ----
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=admin

# ---- Agent limits ----
MAX_SQL_ATTEMPTS=3
SQL_ROW_LIMIT=5000
SQL_TIMEOUT_MS=15000
FEEDBACK_TOP_K=5

# ---- Determinism (benchmarks) ----
LLM_TEMPERATURE=0.0
DATA_SEED=42

# ---- Agent engine ----
# graph = LangGraph state machine, sequential = plain function pipeline
AGENT_ENGINE=sequential
